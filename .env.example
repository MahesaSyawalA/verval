# Konfigurasi Database MySQL (Prisma)
DATABASE_URL="mysql://root:@localhost:3306/nodecraft_rpl"

# Rahasia JWT Session Cookie (WAJIB di production, minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Penyimpanan berkas: "disk" (bawaan, folder lokal) atau "blob" (Vercel Blob privat).
# Wajib "blob" di Vercel karena disk di sana tidak permanen. Variabel NEXT_PUBLIC_
# dibaca browser dan server saat build, jadi isi sebelum build.
NEXT_PUBLIC_STORAGE_DRIVER="disk"

# Direktori penyimpanan berkas lokal (hanya untuk driver "disk")
STORAGE_DIR="./storage"

# Token Vercel Blob (hanya untuk driver "blob"). Dibuat otomatis saat Blob store
# dihubungkan ke proyek Vercel; untuk dev lokal ambil dengan `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# Contoh DATABASE_URL untuk Aiven MySQL (SSL wajib; ganti semua nilai huruf besar):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb?sslaccept=strict&connection_limit=5"
# Bila muncul error TLS, uji dengan sslaccept=accept_invalid_certs atau sertakan CA Aiven.

# Akun Demo Seed (Password default semua akun demo: RplCibiru2026!)
# - Kaprodi : iqbal@upi.edu (NIP: 198204152008121002)
# - Dosen   : indira@upi.edu (NIP: 199008212018032001)
